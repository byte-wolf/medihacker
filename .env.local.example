# SQLite database file (gitignored)
DATABASE_URL=./medihacker.db

# Folder that contains one sub-folder per patient (the hackathon data, never committed)
PATIENT_DATA_DIR=./data/data

# Secret used to sign the session cookie (any random string)
SESSION_SECRET=change-me

# LLM provider: "openrouter", "openai-compatible" (any OpenAI-style endpoint, e.g. a local Ollama) or "mock" (no model)
LLM_PROVIDER=openrouter

# OpenRouter (key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Model for extraction, chat and the contradiction check ("openrouter/free" picks a free model per request)
OPENROUTER_MODEL=openrouter/free
# Optional faster model for planning and translation (defaults to OPENROUTER_MODEL)
OPENROUTER_FAST_MODEL=
# Optional endpoint override
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Generic OpenAI-compatible endpoint (only used when LLM_PROVIDER=openai-compatible)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_FAST_MODEL=

# Max parallel LLM requests (the rest wait in a queue)
# LLM_MAX_CONCURRENCY=6

# Request timeout per LLM call in milliseconds
LLM_TIMEOUT_MS=30000
