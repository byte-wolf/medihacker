# SQLite database file (gitignored)
DATABASE_URL=./medihacker.db

# Folder that contains one sub-folder per patient (the hackathon data, never committed)
PATIENT_DATA_DIR=./data/data

# Secret used to sign the session cookie (any random string)
SESSION_SECRET=change-me

# LLM provider: "bob" (IBM Bob inference API), "openai-compatible" (any OpenAI-style endpoint), "devin" (Devin API) or "mock"
LLM_PROVIDER=bob

# IBM Bob inference API (OpenAI-compatible chat/completions)
BOB_API_KEY=              # key with "Inference" scope (or "General" + BOB_TEAM_ID)
BOB_BASE_URL=             # e.g. https://<bob-host>/v1  (the app calls <BOB_BASE_URL>/chat/completions)
BOB_TEAM_ID=              # sent as x-team-id header (required for inference with a "General" key)
BOB_INSTANCE_ID=          # sent as x-instance-id header, if your instance needs it
BOB_MODEL=                # model id used for extraction and chat
BOB_FAST_MODEL=           # optional faster model for planning/translation (defaults to BOB_MODEL)
# BOB_EXTRA_HEADERS={"x-some-header":"value"}   # optional JSON object of extra headers

# Generic OpenAI-compatible endpoint (only used when LLM_PROVIDER=openai-compatible)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_FAST_MODEL=

# Devin API (only used when LLM_PROVIDER=devin). Each LLM call runs as a short Devin session.
# DEVIN_API_KEY=          # service user token (needs permission to create and manage sessions)
# DEVIN_ORG_ID=           # organization ID, e.g. org-…
# DEVIN_MODE=lite         # normal, fast, lite, ultra or fusion
# DEVIN_FAST_MODE=        # optional mode for planning/translation (defaults to DEVIN_MODE)
# DEVIN_MAX_ACU_LIMIT=    # optional ACU cap per session
# DEVIN_TIMEOUT_MS=600000 # overall timeout per call
# DEVIN_POLL_MS=3000

# Request timeout per LLM call in milliseconds
LLM_TIMEOUT_MS=30000
