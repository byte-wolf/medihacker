# SQLite database file (gitignored)
DATABASE_URL=./medihacker.db

# Folder that contains one sub-folder per patient (the hackathon data, never committed)
PATIENT_DATA_DIR=./data/data

# Secret used to sign the session cookie (any random string)
SESSION_SECRET=change-me

# LLM provider: "gemini", "openai-compatible" (any OpenAI-style endpoint, e.g. a local Ollama) or "mock" (no model)
LLM_PROVIDER=gemini

# Google Gemini API (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Model for extraction, chat and the contradiction check
GEMINI_MODEL=
# Optional faster model for planning and translation (defaults to GEMINI_MODEL)
GEMINI_FAST_MODEL=
# Optional: override the endpoint (default: Google's OpenAI-compatible endpoint)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Generic OpenAI-compatible endpoint (only used when LLM_PROVIDER=openai-compatible)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_FAST_MODEL=

# Request timeout per LLM call in milliseconds
LLM_TIMEOUT_MS=30000
