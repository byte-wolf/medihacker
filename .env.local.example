# SQLite database file (gitignored)
DATABASE_URL=./medihacker.db

# Folder that contains one sub-folder per patient (the hackathon data, never committed)
PATIENT_DATA_DIR=./data/data

# Secret used to sign the session cookie (any random string)
SESSION_SECRET=change-me

# LLM provider: "openrouter", "openai-compatible" (any OpenAI-style endpoint, e.g. a local Ollama) or "mock" (no model)
LLM_PROVIDER=openrouter

# OpenRouter (key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Models for extraction, chat and the contradiction check, as an ordered fallback list:
# when one refuses (e.g. excluded by zero data retention), is rate-limited or answers badly, the next is used.
# Benchmarked with `bun run bench`: gemini-3.1-flash-lite is the only one fast enough for the 10 s target.
OPENROUTER_MODEL=google/gemini-3.1-flash-lite,deepseek/deepseek-v4.1-flash-1017,anthropic/claude-haiku-5.5
# Optional list for planning and translation (defaults to OPENROUTER_MODEL)
OPENROUTER_FAST_MODEL=google/gemini-3.1-flash-lite,deepseek/deepseek-v4.1-flash-1017
# Hidden reasoning effort sent to OpenRouter (minimal keeps answers fast; higher values used up max_tokens in tests)
# OPENROUTER_REASONING_EFFORT=minimal
# Max time one model gets before the next one in the list is tried
# LLM_MODEL_TIMEOUT_MS=20000
# Optional endpoint override
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Generic OpenAI-compatible endpoint (only used when LLM_PROVIDER=openai-compatible)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_FAST_MODEL=

# Items answered per extraction call (1-8, default 2). Every call sends the whole record:
# 4 = about half the input tokens of 2, but each call writes more and takes longer.
# LLM_ITEMS_PER_CALL=2

# Max parallel LLM requests (the rest wait in a queue)
# LLM_MAX_CONCURRENCY=12

# Request timeout per LLM call in milliseconds
LLM_TIMEOUT_MS=30000
